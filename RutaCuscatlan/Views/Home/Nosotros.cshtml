@{ ViewData["Title"] = "Sobre nosotros"; }
<section class="about-page">
    <div class="wrap">
        <p class="eyebrow">Sobre nosotros</p>
        <h1 class="about-title">Quién hizo Ruta Cuscatlán</h1>
        <p class="lead about-lead">Ruta Cuscatlán es una aplicación web para descubrir destinos de El Salvador, explorar tours y reservar un lugar. Fue diseñada y desarrollada por José Javier Flores Rivera, ingeniero, para una agencia de turismo.</p>

        <div class="team-grid solo">
            <article class="team-card reveal">
                <img src="~/images/equipo/jose-flores.jpg" alt="Fotografía de José Javier Flores Rivera" loading="lazy" width="320" height="400">
                <div class="t">
                    <h2>José Javier Flores Rivera</h2>
                    <p class="tag">Ingeniero</p>
                </div>
            </article>
        </div>
    </div>
</section>
